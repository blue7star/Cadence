{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Contract",
  "type": "object",
  "required": [
    "task_id",
    "contract_version",
    "base_revision",
    "gate_level",
    "status",
    "owner",
    "modules",
    "requirement_quote",
    "user_problem",
    "out_of_scope",
    "acceptance_command",
    "stop_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{8}-[a-z0-9-]+$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "base_revision": { "type": "string", "minLength": 7 },
    "gate_level": { "type": "string", "enum": ["G0", "G1", "G2", "G3"] },
    "status": { "type": "string", "enum": ["PLANNED", "IN_PROGRESS", "READY_FOR_REVIEW", "PASS", "ACCEPTED"] },
    "owner": { "type": "string", "enum": ["Planner", "Worker", "Reviewer", "Human"] },
    "modules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "空数组表示 none；M3 按此列表追加蓝图变更历史"
    },
    "sibling_tasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-[0-9]{8}-[a-z0-9-]+$" },
      "description": "并行分派的同批任务；单任务为空数组"
    },
    "parallel_group": { "type": "string" },
    "blueprint_impact": { "type": "string", "enum": ["pending", "none", "required"] },
    "requirement_quote": {
      "type": "string",
      "minLength": 1,
      "description": "用户原话，原样引用；M8 必填，占位符即 BLOCKED"
    },
    "user_problem": {
      "type": "string",
      "minLength": 1,
      "description": "谁在什么场景卡住；只写问题，不写方案"
    },
    "out_of_scope": {
      "type": "string",
      "minLength": 1,
      "description": "M8 必填：这次明确不做什么（旧版写作数组，2026-11-09 起统一为字符串）"
    },
    "acceptance_command": {
      "type": "string",
      "minLength": 1,
      "description": "一条可执行命令 + 期望退出码"
    },
    "stop_conditions": {
      "type": "string",
      "minLength": 1,
      "description": "什么情况必须停下问人"
    },
    "rollback": { "type": "string", "description": "G3 必填" }
  }
}
