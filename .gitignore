# 运行时数据：数据库里是真实业务数据，不进版本库（首次启动会自动建库）
data/

# 本地开发产物。注意：_dev 下的脚本要进版本库（e2e 就是靠它复跑），
# 只有跑出来的东西才忽略——否则换台机器连验证都做不了。
_dev/shots/
_dev/chrome-profile/
_dev/verify-report.json
_dev/verify-report-fast.json
_dev/verify-report-last-fail.json
_dev/*.log
_dev/*.json
# 完整校验的报告是证据，要进库（上面那条 `_dev/*.json` 会把它一起忽略，这里放行）
!_dev/verify-report.json
_dev/t-*.csv
# --full 每次重建的测试库副本（真实库 data/workbench.db 不参与 e2e）
_dev/.test-db/

node_modules/

# 日志与临时文件
*.log
*.tmp

# 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini

# Python 字节码（跑 gate.py 会生成，不是源码）
__pycache__/
*.pyc
